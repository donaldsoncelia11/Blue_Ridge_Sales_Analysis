-- Question: Which equipment sales are purchased most frequently? 

SELECT
    count(t.transaction_id) as times_purchased,
    
    sp.item_name
from transactions as t 

INNER JOIN services_products as sp
    on sp.item_id=t.item_id
INNER JOIN categories as ct
    on ct.category_id=sp.category_id

where ct.category_type='Product'

GROUP BY sp.item_name

order by times_purchased DESC

